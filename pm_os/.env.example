# Copy to .env (git-ignored). Never commit real keys.
ANTHROPIC_API_KEY=
# The SEC requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT_NAME=PM-OS research tool
SEC_USER_AGENT_EMAIL=
# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Optional: claude-opus-5-5 (default) or claude-sonnet-5-5
PM_OS_MODEL=claude-opus-5-5
